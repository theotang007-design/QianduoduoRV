# ===== 钱多多智能复盘 配置模板 =====
# 复制本文件为 .env 并填写实际值

# --- AI 服务配置（二选一或都填，优先使用 AI_PROVIDER 指定） ---
# 可选值: deepseek | volcengine
AI_PROVIDER=deepseek

# DeepSeek（OpenAI兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 火山引擎（豆包/Doubao）
VOLC_API_KEY=
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_MODEL=doubao-pro-32k

# --- 服务监听 ---
WEB_HOST=127.0.0.1
WEB_PORT=5000

# --- 数据限制（控制AI调用成本） ---
# 每只股票每日最多分析新闻条数
MAX_NEWS_PER_STOCK_PER_DAY=5
# 每个数据源抓取最大条数
MAX_NEWS_PER_SOURCE=10